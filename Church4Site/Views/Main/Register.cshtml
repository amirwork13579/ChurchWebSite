@model Church4Site.Models.UserDto


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register Page</title>
    <link rel="stylesheet" href="~/css/Register.css">
</head>
<body>



    @*background shapes*@
    <div class="backgroundrandom-wrapper">
        <div class="backgroundrandom-shape backgroundrandom-circle" style="--i:1; --c:#ff007f; --x:10vw; --size:120px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-rect" style="--i:2; --c:#00d4ff; --x:40vw; --size:180px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-blob" style="--i:3; --c:#ccff00; --x:70vw; --size:140px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-circle" style="--i:4; --c:#7000ff; --x:85vw; --size:100px;"></div>
    </div>


    @*navbar*@
    <nav class="seethronavbar-wrapper">
        <div class="seethronavbar-container">
            <a href="#" class="seethronavbar-logo">DESIGN<span>CO</span></a>

            <button class="seethronavbar-toggle" id="navbar-hamburger" aria-label="Toggle Menu">
                <span class="seethronavbar-icon"></span>
            </button>

            <ul class="seethronavbar-menu" id="navbar-menu">
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="OurStaff">OurStaff</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="Testimonies">Testimonies</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="Calendar">Calendar</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="OurBeliefs">Our Beliefs</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="MainPage">Main</a></li>
                <li><button onclick="openDonateOptions(this)" class="donateOptionsPopup-trigger-btn">Donate</button></li>
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <li><a class="seethronavbar-link" asp-area="" asp-controller="AdminFile" asp-action="AdminPage">Admin</a></li>
                }
            </ul>
        </div>
    </nav>




    @*register form*@
    <div class="registerform-card-wrapper">
        <form asp-action="Register" class="registerform-card" id="registrationForm">
            <div class="registerform-header">
                <h2 class="registerform-title">Join Us</h2>
                <p class="registerform-subtitle">Create your account to continue</p>
            </div>
            <div class="registerform-body">
            

                <div class="registerform-field">
                    <label class="registerform-label">Email Address</label>
                    <div class="registerform-input-wrapper">
                        <input asp-for="@Model.Username" type="email" class="registerform-input" placeholder="name@company.com" required id="emailInput">
                        <span class="registerform-check-icon"></span>
                    </div>
                </div>

                <div class="registerform-field">
                    <label class="registerform-label">Password</label>
                    <div class="registerform-input-wrapper">
                        <input asp-for="@Model.Password" type="password" id="registerform-pass" class="registerform-input" placeholder="••••••••" minlength="8" required>
                        <span class="registerform-check-icon"></span>
                    </div>
                </div>

                <div class="registerform-field">
                    <label class="registerform-label">Confirm Password</label>
                    <div class="registerform-input-wrapper">
                        <input type="password" id="registerform-confirm" class="registerform-input" placeholder="••••••••" required>
                        <span class="registerform-check-icon"></span>
                    </div>
                    <span id="registerform-error" class="registerform-error-msg">Passwords do not match</span>
                </div>


            </div>
            <button type="submit" class="registerform-submit-btn">Create Account</button>

            <div class="registerform-footer">
                Already have an account? 
                <a asp-action="LogIn" class="registerform-link">Sign In</a>
            </div>
        </form>
    </div>





    @*email exists popup*@
    <div id="emailErrorModal" class="modal-overlay" style="display: none;">
        <div class="modal-content">
            <div class="modal-header">
                <span class="modal-icon">⚠️</span>
                <h2>Email Taken</h2>
            </div>
            <div class="modal-body">
                <p>The email address you entered is already registered with an account.</p>
            </div>
            <div class="modal-footer">
                <button type="button" onclick="emailErrorModalClose()" class="modal-close-btn">Got it</button>
            </div>
        </div>
    </div>


          


    @*js password confirm*@
    <script>

                document.addEventListener('DOMContentLoaded', () => {
            const pass = document.getElementById('registerform-pass');
            const confirm = document.getElementById('registerform-confirm');
            const errorMsg = document.getElementById('registerform-error');

            function checkPasswords() {
                if (confirm.value.length > 0 && pass.value !== confirm.value) {
                    confirm.setCustomValidity("Mismatch");
                    errorMsg.style.display = 'block';
                } else {
                    confirm.setCustomValidity("");
                    errorMsg.style.display = 'none';
                }
            }

            pass.addEventListener('input', checkPasswords);
            confirm.addEventListener('input', checkPasswords);
        });

    </script>




    @*donate options popup*@
    <div class="donateOptionsPopup-overlay" id="donateOptionsPopup-overlay">

        <div class="donateOptionsPopup-container">

            <button class="donateOptionsPopup-close" onclick="closeDonateOptions(this)" id="donateOptionsPopup-close" aria-label="Close">
                &times;
            </button>

            <div class="donateOptionsPopup-header">
                <h2 class="donateOptionsPopup-title">Support Our Church</h2>
                <p class="donateOptionsPopup-subtitle">Select a secure payment method to give.</p>
            </div>

            <div class="donateOptionsPopup-grid">

                <div class="donateOptionsPopup-card" data-method="paypal">
                    <div class="donateOptionsPopup-icon">
                        <span class="donateOptionsPopup-emoji">💳</span>
                    </div>
                    <div class="donateOptionsPopup-details">
                        <span class="donateOptionsPopup-method-name">PayPal</span>
                        <span class="donateOptionsPopup-method-meta">Credit Card / Account</span>
                    </div>
                    <div class="donateOptionsPopup-action-icon">→</div>
                </div>

                <div class="donateOptionsPopup-card" data-method="zelle">
                    <div class="donateOptionsPopup-icon">
                        <span class="donateOptionsPopup-emoji">📱</span>
                    </div>
                    <div class="donateOptionsPopup-details">
                        <span class="donateOptionsPopup-method-name">Zelle</span>
                        <span class="donateOptionsPopup-method-meta">Copy Email Address</span>
                    </div>
                    <div class="donateOptionsPopup-action-icon">📋</div>
                </div>

                <div class="donateOptionsPopup-card" data-method="cashapp">
                    <div class="donateOptionsPopup-icon">
                        <span class="donateOptionsPopup-emoji">💵</span>
                    </div>
                    <div class="donateOptionsPopup-details">
                        <span class="donateOptionsPopup-method-name">CashApp</span>
                        <span class="donateOptionsPopup-method-meta">$YourChurchTag</span>
                    </div>
                    <div class="donateOptionsPopup-action-icon">→</div>
                </div>

            </div>

            <div class="donateOptionsPopup-footer">
                <p>Thank you for your generosity!</p>
            </div>
        </div>
    </div>


    <script>
                // Donate options popup and close
        function openDonateOptions(elmnt) {
            const overlay = document.getElementById('donateOptionsPopup-overlay');
            overlay.style.display = 'flex'
        }
        function closeDonateOptions(elmnt) {
            const overlay = document.getElementById('donateOptionsPopup-overlay');
            overlay.style.display = 'none';
        }

    </script>


    <script src="~/js/Register.js"></script>
</body>
</html>
