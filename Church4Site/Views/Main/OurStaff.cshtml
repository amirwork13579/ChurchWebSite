@model List<Church4Site.Entities.TeamMember>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Login</title>
    <link rel="stylesheet" href="~/css/OurStaff.css">
    <script src="~/js/site.js"></script>
</head>

<body>





    @*background shapes*@
    <div class="backgroundrandom-wrapper">
        <div class="backgroundrandom-shape backgroundrandom-circle" style="--i:1; --c:#ff007f; --x:10vw; --size:120px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-rect" style="--i:2; --c:#00d4ff; --x:40vw; --size:180px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-blob" style="--i:3; --c:#ccff00; --x:70vw; --size:140px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-circle" style="--i:4; --c:#7000ff; --x:85vw; --size:100px;"></div>
    </div>




    @*navbar*@
    <nav class="seethronavbar-wrapper">
        <div class="seethronavbar-container">
            <a href="#" class="seethronavbar-logo">DESIGN<span>CO</span></a>

            <button class="seethronavbar-toggle" id="navbar-hamburger" aria-label="Toggle Menu">
                <span class="seethronavbar-icon"></span>
            </button>

            <ul class="seethronavbar-menu" id="navbar-menu">
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="SunDays">Sundays</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="Testimonies">Testimonies</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="Calendar">Calendar</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="MainPage">Main</a></li>
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <li><a class="seethronavbar-link" asp-area="" asp-controller="AdminFile" asp-action="AdminPage">Admin</a></li>
                }
                <li><a asp-action="ContactForm" class="seethronavbar-btn">Get Started</a></li>
            </ul>
        </div>
    </nav>

  



    @*stylish see thro title*@
    <div class="titletop-outer-section">
        <div class="titletop-border-line"></div>

        <div class="titletop-center-box">
            <div class="titletop-eyebrow">HEALING MINISTRY</div>
            <div class="titletop-hero-title">OUR TEAM</div>
            <div class="titletop-hero-subtitle">STORIES OF TRANSFORMATION</div>
        </div>

        <div class="titletop-border-line"></div>
    </div>




    @*team member display*@
    <section class="teammembercard-section">
        <div class="teammembercard-container">
            <div class="teammembercard-header">
                <h2 class="teammembercard-title"></h2>
                <p class="teammembercard-subtitle"></p>
            </div>
            <div class="teammembercard-grid">
                @foreach (var member in Model)
                {
                    <div class="teammembercard-item">
                        <div class="teammembercard-image-wrapper">
                            <img src="@member.ImageUrl" alt="Team Member" class="teammembercard-img">
                            <div class="teammembercard-socials">
                                <a href="#" class="teammembercard-social-link">LN</a>
                                <a href="#" class="teammembercard-social-link">TW</a>
                            </div>
                        </div>
                        <div class="teammembercard-info">
                            <h3 class="teammembercard-name">Name- @member.Name</h3>
                            <p class="teammembercard-position">Role- @member.Position</p>
                            <p class="teammembercard-bio">Bio- @member.Description</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </section>








</body>
</html>
