@model List<Church4Site.Entities.EventData>


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Login</title>
    <link rel="stylesheet" href="~/css/MainPage.css">
    <script src="~/js/site.js"></script>
</head>

<body>


   

    @*render hero section differently*@
    @section FullWidthTop {
    }

    


    @*donate options popup*@
    <div class="donateOptionsPopup-overlay" id="donateOptionsPopup-overlay">

        <div class="donateOptionsPopup-container">

            <button class="donateOptionsPopup-close" onclick="closeDonateOptions(this)" id="donateOptionsPopup-close" aria-label="Close">
                &times;
            </button>

            <div class="donateOptionsPopup-header">
                <h2 class="donateOptionsPopup-title">Support Our Church</h2>
                <p class="donateOptionsPopup-subtitle">Select a secure payment method to give.</p>
            </div>

            <div class="donateOptionsPopup-grid">

                <div class="donateOptionsPopup-card" data-method="paypal">
                    <div class="donateOptionsPopup-icon">
                        <span class="donateOptionsPopup-emoji">💳</span>
                    </div>
                    <div class="donateOptionsPopup-details">
                        <span class="donateOptionsPopup-method-name">PayPal</span>
                        <span class="donateOptionsPopup-method-meta">Credit Card / Account</span>
                    </div>
                    <div class="donateOptionsPopup-action-icon">→</div>
                </div>

                <div class="donateOptionsPopup-card" data-method="zelle">
                    <div class="donateOptionsPopup-icon">
                        <span class="donateOptionsPopup-emoji">📱</span>
                    </div>
                    <div class="donateOptionsPopup-details">
                        <span class="donateOptionsPopup-method-name">Zelle</span>
                        <span class="donateOptionsPopup-method-meta">Copy Email Address</span>
                    </div>
                    <div class="donateOptionsPopup-action-icon">📋</div>
                </div>

                <div class="donateOptionsPopup-card" data-method="cashapp">
                    <div class="donateOptionsPopup-icon">
                        <span class="donateOptionsPopup-emoji">💵</span>
                    </div>
                    <div class="donateOptionsPopup-details">
                        <span class="donateOptionsPopup-method-name">CashApp</span>
                        <span class="donateOptionsPopup-method-meta">$YourChurchTag</span>
                    </div>
                    <div class="donateOptionsPopup-action-icon">→</div>
                </div>

            </div>

            <div class="donateOptionsPopup-footer">
                <p>Thank you for your generosity!</p>
            </div>
        </div>
    </div>


    <script>
                // Donate options popup and close
        function openDonateOptions(elmnt) {
            const overlay = document.getElementById('donateOptionsPopup-overlay');
            overlay.style.display = 'flex'
        }
        function closeDonateOptions(elmnt) {
            const overlay = document.getElementById('donateOptionsPopup-overlay');
            overlay.style.display = 'none';
        }

    </script>
  


    @*video hero section*@
    <div class="videohero-master-wrapper">
        <section class="videohero-section">
            <div class="videohero-container">
                <video class="videohero-video" autoplay muted loop playsinline>
                    <source src="~/css/Videos/Churchvideo2.mp4" type="video/mp4">
                </video>

                <div class="videohero-overlay">
                    <div class="videohero-center-content">
                        <h1 class="videohero-title">AESTHETIC</h1>
                        <div class="videohero-line"></div>
                        <p class="videohero-subtitle">Visual Experience</p>
                    </div>

                    <nav class="videohero-footer">
                        <a href="#" class="videohero-social">Instagram</a>
                        <a href="#" class="videohero-social">Twitter</a>
                        <a href="#" class="videohero-social">YouTube</a>
                    </nav>
                </div>
            </div>
        </section>
    </div>



    @*section separator*@
    <div class="sectionseparator-container">
        <div class="sectionseparator-line"></div>
        <span class="sectionseparator-text">Our Services</span>
        <div class="sectionseparator-line"></div>
    </div>




    @*event cards section*@
    <section class="eventcards-section">
        <div class="eventcards-container">
            @foreach(var s in Model)
            {
                <div class="eventcards-card">
                    <div class="eventcards-image-wrapper">
                        <img src="@s.ImageUrl" alt="Event One" class="eventcards-img">
                        <div class="eventcards-tag">Featured</div>
                    </div>
                    <div class="eventcards-content">
                        <span class="eventcards-date">@s.Date</span>
                        <span class="eventcards-date">@s.Time</span>
                        <h3 class="eventcards-title">@s.Name</h3>
                        <p class="eventcards-description">@s.Description</p>
                        <a asp-action="Calendar" class="eventcards-link">Learn More</a>
                    </div>
                </div>
            }
        </div>
    </section>



    @*section separator*@
    <div class="sectionseparator-container">
        <div class="sectionseparator-line"></div>
        <span class="sectionseparator-text">Our Services</span>
        <div class="sectionseparator-line"></div>
    </div>


    @*image fadeout to the right*@
    <section class="imagefaderight-section">
        <div class="imagefaderight-container">

            <div class="imagefaderight-visual-wrapper">
                <img src="~/css/Images/church.webp" class="imagefaderight-img">
            </div>

            <div class="imagefaderight-content">
                <h2 class="imagefaderight-title">Modern Design</h2>
                <p class="imagefaderight-text">
                    The image now features a deeper fade, starting earlier to blend
                    perfectly with your background video and shapes.
                </p>
                <a href="#" class="imagefaderight-btn">Learn More</a>
            </div>

        </div>
    </section>




    @*section separator*@
    <div class="sectionseparator-container">
        <div class="sectionseparator-line"></div>
        <span class="sectionseparator-text">Our Services</span>
        <div class="sectionseparator-line"></div>
    </div>




    @*image fadeout to the left*@
    <section class="imagefadeleft-section">
        <div class="imagefadeleft-container">

            <div class="imagefadeleft-content">
                <h2 class="imagefadeleft-title">REVERSED DESIGN</h2>
                <p class="imagefadeleft-text">
                    This version places the text on the left, while the image sits on the right
                    and fades out toward the center.
                </p>
                <a href="#" class="imagefadeleft-btn">Explore</a>
            </div>

            <div class="imagefadeleft-visual-wrapper">
                <img src="~/css/Images/youngchurch.jpg" class="imagefadeleft-img">
            </div>

        </div>
    </section>


    @*section separator*@
    <div class="sectionseparator-container">
        <div class="sectionseparator-line"></div>
        <span class="sectionseparator-text">Our Services</span>
        <ul>
            @if(User.Identity.IsAuthenticated)
            {
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="LogOut">LogOut</a></li>
            }
            else
            {
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="Register">Register</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="Login">Login</a></li>
            }
        </ul>
        <div class="sectionseparator-line"></div>
    </div>



   







</body>
</html>