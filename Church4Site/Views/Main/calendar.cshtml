@model List<Church4Site.Entities.EventData>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Login</title>
    <link rel="stylesheet" href="~/css/Calendar.css">
    <script src="~/js/site.js"></script>
</head>

<body>


    @*background shapes*@
    <div class="backgroundrandom-wrapper">
        <div class="backgroundrandom-shape backgroundrandom-circle" style="--i:1; --c:#ff007f; --x:10vw; --size:120px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-rect" style="--i:2; --c:#00d4ff; --x:40vw; --size:180px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-blob" style="--i:3; --c:#ccff00; --x:70vw; --size:140px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-circle" style="--i:4; --c:#7000ff; --x:85vw; --size:100px;"></div>
    </div>


    @*navbar*@
    <nav class="seethronavbar-wrapper">
        <div class="seethronavbar-container">
            <a href="#" class="seethronavbar-logo">BL<span>W</span> Church</a>

            <button class="seethronavbar-toggle" id="navbar-hamburger" aria-label="Toggle Menu">
                <span class="seethronavbar-icon"></span>
            </button>

            <ul class="seethronavbar-menu" id="navbar-menu">
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="OurStaff">OurStaff</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="SunDays">Sundays</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="Testimonies">Testimonies</a></li>
                <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="MainPage">Main</a></li>
                @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                {
                    <li><a class="seethronavbar-link" asp-area="" asp-controller="AdminFile" asp-action="AdminPage">Admin</a></li>
                }
                <li><a asp-action="ContactForm" class="seethronavbar-btn">Get Started</a></li>
            </ul>
        </div>
    </nav>






    @*video hero section*@
    <div class="videohero-master-wrapper">
        <section class="videohero-section">
            <div class="videohero-container">
                <video class="videohero-video" autoplay muted loop playsinline>
                    <source src="~/css/Videos/Churchvideo2.mp4" type="video/mp4">
                </video>

                <div class="videohero-overlay">
                    <div class="videohero-center-content">


                        <div class="calendar-wrapper">
                            <iframe src="https://calendar.google.com/calendar/embed?src=YOUR_ID_HERE&ctz=UTC"
                                    scrolling="no">
                            </iframe>
                        </div>
     

                    <nav class="videohero-footer">
                        <a href="#" class="videohero-social">Instagram</a>
                        <a href="#" class="videohero-social">Twitter</a>
                        <a href="#" class="videohero-social">YouTube</a>
                    </nav>
                </div>
            </div>
            </div>
        </section>
    </div>





    




    @*section separator*@
    <div class="sectionseparator-container">
        <div class="sectionseparator-line"></div>
        <span class="sectionseparator-text">Upcoming Events</span>
        <div class="sectionseparator-line"></div>
    </div>




    @*event cards section*@
    <section class="eventcards-section">
        <div class="eventcards-container">
            @foreach (var s in Model)
            {
                <div class="eventcards-card">
                    <div class="eventcards-image-wrapper">
                        <img src="@s.ImageUrl" alt="Event One" class="eventcards-img">
                        <div class="eventcards-tag">Featured</div>
                    </div>
                    <div class="eventcards-content">
                        <span class="eventcards-date">@s.Date</span>
                        <span class="eventcards-date">@s.Time</span>
                        <h3 class="eventcards-title">@s.Name</h3>
                        <p class="eventcards-description">@s.Description</p>
                        <a asp-action="Calendar" class="eventcards-link">Learn More</a>
                    </div>
                </div>
            }
        </div>
    </section>


</body>
</html>