
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Modern Login</title>
    <link rel="stylesheet" href="~/css/Test.css">
</head>

<body>


    @*background shapes*@
    <div class="backgroundrandom-wrapper">
        <div class="backgroundrandom-shape backgroundrandom-circle" style="--i:1; --c:#ff007f; --x:10vw; --size:120px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-rect" style="--i:2; --c:#00d4ff; --x:40vw; --size:180px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-blob" style="--i:3; --c:#ccff00; --x:70vw; --size:140px;"></div>
        <div class="backgroundrandom-shape backgroundrandom-circle" style="--i:4; --c:#7000ff; --x:85vw; --size:100px;"></div>
    </div>


    <div class="cloudbackground-container">
        <div class="cloudbackground-sky">
            <div class="cloudbackground-cloud cloudbackground-c1"></div>
            <div class="cloudbackground-cloud cloudbackground-c2"></div>
            <div class="cloudbackground-cloud cloudbackground-c3"></div>
        </div>

        <div class="cloudbackground-hills">
            <svg viewBox="0 0 1440 320" preserveAspectRatio="none" class="cloudbackground-hill-svg">
                <path fill="#2dcc70" d="M0,224L60,202.7C120,181,240,139,360,138.7C480,139,600,181,720,208C840,235,960,245,1080,224C1200,203,1320,149,1380,122.7L1440,96L1440,320L1380,320C1320,320,1200,320,1080,320C960,320,840,320,720,320C600,320,480,320,360,320C240,320,120,320,60,320L0,320Z"></path>
            </svg>
            <svg viewBox="0 0 1440 320" preserveAspectRatio="none" class="cloudbackground-hill-svg cloudbackground-hill-back">
                <path fill="#27ae60" d="M0,160L80,176C160,192,320,224,480,213.3C640,203,800,149,960,144C1120,139,1280,181,1360,202.7L1440,224L1440,320L1360,320C1280,320,1120,320,960,320C800,320,640,320,480,320C320,320,160,320,80,320L0,320Z"></path>
            </svg>
        </div>
    </div>



</body>
</html>



