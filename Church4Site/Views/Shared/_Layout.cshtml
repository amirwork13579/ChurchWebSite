<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    @* --- 1. THE TITLE (Dynamic from each page) --- *@
    <title>@ViewData["Title"] - BLW Church Sheffield</title>

    @* --- 2. SEO ESSENTIALS --- *@
    <meta name="description" content="@ViewData["Description"]" />
    <link rel="canonical" href="https://soft-tech.uk@Context.Request.Path" />
    <meta name="robots" content="index, follow" />

    @* --- 3. SOCIAL MEDIA (Open Graph) --- *@
    <meta property="og:type" content="website" />
    <meta property="og:title" content="@ViewData["Title"]" />
    <meta property="og:description" content="@ViewData["Description"]" />
    <meta property="og:url" content="https://soft-tech.shop@Context.Request.Path" />
    <meta property="og:image" content="https://soft-tech.shop/images/social-preview.jpg" />

    @* --- 4. ICONS & MOBILE --- *@
    <link rel="icon" type="image/png" href="~/favicon.png">
    <link rel="apple-touch-icon" sizes="180x180" href="~/images/apple-touch-icon.png">

    @* --- 5. STYLES & SCRIPTS --- *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Church4Site.styles.css" asp-append-version="true" />
    <script src="~/js/site.js" asp-append-version="true"></script>

    @* --- 6. STRUCTURED DATA (Tells Google you are a real business) --- *@
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "ChristianChurch",
          "name": "BLW Church Sheffield",
          "url": "https://soft-tech.shop",
          "description": "BLW - Belivers Love World, a church for Belivers in Jesus Christ our Lord and Savior",
          "address": {
            "@@type": "PostalAddress",
            "addressLocality": "Sheffield",
            "addressRegion": "England"
          }
        }
    </script>
</head>
<body>

    @*background shapes*@
    <div class="backgroundBlackGold-fixed-bg">
        <div class="backgroundBlackGold-blob backgroundBlackGold-gold-1"></div>
        <div class="backgroundBlackGold-blob backgroundBlackGold-gold-2"></div>

        <div class="backgroundBlackGold-vignette"></div>
    </div>


    <header>


        @*navbar*@
        <nav class="seethronavbar-wrapper">
            <div class="seethronavbar-container">
                <a asp-controller="Main" asp-action="MainPage" class="seethronavbar-logo">
                    <img src="/css/Images/Artboard 6.png" alt="BLW Church Logo" class="navbar-logo-img">
                </a>

                <button class="seethronavbar-toggle" id="navbar-hamburger" aria-label="Toggle Menu">
                    <span class="seethronavbar-icon"></span>
                </button>

                <ul class="seethronavbar-menu" id="navbar-menu">
                    <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="OurStaff">OurStaff</a></li>
                    <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="OurBeliefs">Our Beliefs</a></li>
                    <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="Testimonies">Testimonies</a></li>
                    <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="Calendar">Calendar</a></li>
                    <li><a class="seethronavbar-link" asp-area="" asp-controller="Main" asp-action="MainPage">Main</a></li>
                    <li><button onclick="openDonateOptions(this)" class="donate-main">Donate</button></li>
                    <li><a asp-action="ContactForm" class="seethronavbar-btn">Contact Us</a></li>

                    @if (User.Identity.IsAuthenticated && User.IsInRole("Admin"))
                    {
                        <li><a class="seethronavbar-link" asp-area="" asp-controller="AdminFile" asp-action="AdminPage">Admin</a></li>
                    }
                </ul>
            </div>
        </nav>



        @*donate options popup*@
        <div class="donateOptionsPopup-overlay" id="donateOptionsPopup-overlay">

            <div class="donateOptionsPopup-container">

                <button class="donateOptionsPopup-close" onclick="closeDonateOptions(this)" id="donateOptionsPopup-close" aria-label="Close">
                    &times;
                </button>

                <div class="donateOptionsPopup-header">
                    <h2 class="donateOptionsPopup-title">Support Our Church</h2>
                    <p class="donateOptionsPopup-subtitle">Select a secure payment method to give.</p>
                </div>

                <div class="donateOptionsPopup-grid">

                    <div class="donateOptionsPopup-card" data-method="paypal">
                        <div class="donateOptionsPopup-icon">
                            <span class="donateOptionsPopup-emoji">💳</span>
                        </div>
                        <div class="donateOptionsPopup-details">
                            <span class="donateOptionsPopup-method-name">PayPal</span>
                            <span class="donateOptionsPopup-method-meta">Credit Card / Account</span>
                        </div>
                        <div class="donateOptionsPopup-action-icon">→</div>
                    </div>

                    <div class="donateOptionsPopup-card" data-method="zelle">
                        <div class="donateOptionsPopup-icon">
                            <span class="donateOptionsPopup-emoji">📱</span>
                        </div>
                        <div class="donateOptionsPopup-details">
                            <span class="donateOptionsPopup-method-name">Zelle</span>
                            <span class="donateOptionsPopup-method-meta">Copy Email Address</span>
                        </div>
                        <div class="donateOptionsPopup-action-icon">📋</div>
                    </div>

                    <div class="donateOptionsPopup-card" data-method="cashapp">
                        <div class="donateOptionsPopup-icon">
                            <span class="donateOptionsPopup-emoji">💵</span>
                        </div>
                        <div class="donateOptionsPopup-details">
                            <span class="donateOptionsPopup-method-name">CashApp</span>
                            <span class="donateOptionsPopup-method-meta">$YourChurchTag</span>
                        </div>
                        <div class="donateOptionsPopup-action-icon">→</div>
                    </div>

                </div>

                <div class="donateOptionsPopup-footer">
                    <p>Thank you for your generosity!</p>
                </div>
            </div>
        </div>


        <script>
                    // Donate options popup and close
            function openDonateOptions(elmnt) {
                const overlay = document.getElementById('donateOptionsPopup-overlay');
                overlay.style.display = 'flex'
            }
            function closeDonateOptions(elmnt) {
                const overlay = document.getElementById('donateOptionsPopup-overlay');
                overlay.style.display = 'none';
            }

        </script>



    </header>

    @*for rendering the hero section differently*@
    @await RenderSectionAsync("FullWidthTop", required: false)

    <div class="">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @*lower site area*@
    <footer class="lowerSiteArea-main-container">
        <div class="lowerSiteArea-wrapper">
            <div class="lowerSiteArea-main-grid">

                <div class="lowerSiteArea-brand-col">
                    <h2 class="lowerSiteArea-logo">BL<span>W</span> Church</h2>
                    <p class="lowerSiteArea-mission">A community dedicated to the message of grace and the pursuit of purpose.</p>
                    <div class="lowerSiteArea-socials">
                        <a href="#" class="lowerSiteArea-social-link">FB</a>
                        <a href="#" class="lowerSiteArea-social-link">IG</a>
                    </div>
                </div>

                <div class="lowerSiteArea-links-col">
                    <h4 class="lowerSiteArea-heading">Quick Links</h4>
                    <ul class="lowerSiteArea-list">
                        @if(User.Identity.IsAuthenticated)
                        {
                            <li><a asp-controller="Main" asp-action="Logout" class="lowerSiteArea-link">Logout</a></li>
                        }
                        else
                        {
                            <li><a asp-controller="Main" asp-action="Register" class="lowerSiteArea-link">Register</a></li>
                            <li><a asp-controller="Main" asp-action="Login" class="lowerSiteArea-link">Login</a></li>

                        }
                        <li><a asp-controller="Main" asp-action="Calendar" class="lowerSiteArea-link">for our Church Schedule - Calendar</a></li>
                    </ul>
                </div>

                <div class="lowerSiteArea-contact-col">
                    <h4 class="lowerSiteArea-heading">Location - Visit Us</h4>
                    <p class="lowerSiteArea-info">123 Faith Avenue, London</p>
                    <button class="lowerSiteArea-btn">Get Directions</button>
                </div>

            </div>

            <div class="lowerSiteArea-bottom-bar">
                <p>&copy; 2026 BLW Church. All Rights Reserved.</p>
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>







